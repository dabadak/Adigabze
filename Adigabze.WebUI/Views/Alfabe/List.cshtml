@model IEnumerable<Harf>
@{
    ViewData["Title"] = "List";
    int i = 0;
}

<div class="container mt-3">
    <div class="row">
        <div class="col-md-11">
            <h2>Alfabe</h2>
        </div>
    </div>
    <div class="row">
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-2 col-sm-3">
                    <a asp-controller="Alfabe" asp-action="Details" asp-route-id="@item.HarfId">
                        <table class="table table-bordered table-striped">
                            <tr>
                                <td>
                                    <center>
                                        <h2>@item.BuyukHarf</h2>
                                    </center>
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>
                                    <center>
                                        <h2>@item.KucukHarf</h2>
                                    </center>
                                </td>
                            </tr>
                        </table>
                    </a>
                </div>
            }
        }
    </div>
</div>






