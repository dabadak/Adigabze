@model IEnumerable<Kazanim>
@{
    ViewData["Title"] = "List";
}

<div class="container mt-3">
    <div class="row">
        <div class="col-md-11">
            <h2>Kazanım Listesi</h2>
        </div>
        <div class="col-md-1"><a class="btn btn-success" asp-controller="Kazanim" asp-action="Create">+Kazanım</a></div>
    </div>
    <div class="row">
        <div class="col">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Kazanım</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.KazanimId</td>
                                <td>@item.KazanimTanim</td>
                                <td>
                                    <a class="btn btn-primary btn-sm" asp-controller="Kazanim" asp-action="Edit" asp-route-id="@item.KazanimId">Edit</a>
                                    <a class="btn btn-danger btn-sm" asp-controller="Kazanim" asp-action="Delete" asp-route-id="@item.KazanimId">Sil</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

